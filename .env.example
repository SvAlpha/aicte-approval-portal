# AI-Supported AICTE Approval Process Portal — Environment Configuration (.env.example)
# Copy this file to backend/.env for local or cloud deployment. Never commit real secrets.
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/aicte_portal
JWT_SECRET=replace-with-256-bit-production-secret
JWT_EXPIRY_SECONDS=28800
OCR_ENGINE_LANG=eng
FRONTEND_ORIGIN=http://localhost:5173
